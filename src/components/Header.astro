---
import { site, nav } from "../data/site";
import MobileNav from "./MobileNav.tsx";
---
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-navy/5">
  <!-- Transition / heritage banner -->
  <div class="bg-navy text-cream text-center text-xs md:text-sm py-2 px-4">
    {site.name} — {site.transitionBanner}
    <span class="opacity-80 hidden sm:inline">({site.heritage})</span>
  </div>

  <div class="container-page relative flex items-center justify-between py-4">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${site.name} — home`}>
      <svg viewBox="0 0 120 140" class="h-10 md:h-12 w-auto shrink-0" aria-hidden="true">
        <g transform="translate(60 66) rotate(22)">
          <path d="M0 -54 C 35 -35, 42 27, 0 62 C -42 27, -35 -35, 0 -54 Z" fill="#8bab97"/>
          <path d="M0 -54 C 21 -31, 23 27, 0 62 C 0 20, 0 -20, 0 -54 Z" fill="#6f9a80"/>
          <path d="M0 -46 L 0 56" stroke="#f4f1e8" stroke-width="3" stroke-linecap="round" fill="none" opacity="0.85"/>
        </g>
      </svg>
      <span class="flex flex-col leading-none">
        <span class="font-heading text-2xl md:text-3xl font-semibold text-navy">Overlake</span>
        <span class="text-slate text-[11px] md:text-xs tracking-[0.2em] uppercase mt-1">Family Dentistry</span>
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-6">
      {nav.map((item) => (
        <a href={item.href} class="text-navy/80 hover:text-navy font-medium text-sm transition-colors">{item.label}</a>
      ))}
      <a href={site.phoneHref} class="btn btn-primary text-sm">Call {site.phone}</a>
    </nav>

    <MobileNav client:load items={nav} phone={site.phone} phoneHref={site.phoneHref} />
  </div>
</header>
