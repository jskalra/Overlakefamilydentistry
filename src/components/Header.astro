---
import { Image } from "astro:assets";
import { site, nav } from "../data/site";
import MobileNav from "./MobileNav.tsx";
import logo from "../assets/logo/overlake-logo.png";
---
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-navy/5">
  <!-- Transition / heritage banner -->
  <div class="bg-navy text-cream text-center text-xs md:text-sm py-2 px-4">
    {site.name} — {site.transitionBanner}
    <span class="opacity-80 hidden sm:inline">({site.heritage})</span>
  </div>

  <div class="container-page relative flex items-center justify-between gap-6 py-4">
    <a href="/" class="flex items-center shrink-0" aria-label={`${site.name} — home`}>
      <Image src={logo} alt={site.name} class="h-9 sm:h-10 lg:h-11 w-auto" widths={[340, 440, 660]} sizes="(max-width: 768px) 175px, 215px" loading="eager" />
    </a>

    <nav class="hidden lg:flex items-center gap-4 xl:gap-6">
      {nav.map((item) => (
        <a href={item.href} class="whitespace-nowrap text-navy/80 hover:text-navy font-medium text-sm transition-colors">{item.label}</a>
      ))}
      <a href={site.phoneHref} class="btn btn-primary text-sm whitespace-nowrap">Call {site.phone}</a>
    </nav>

    <MobileNav client:load items={nav} phone={site.phone} phoneHref={site.phoneHref} />
  </div>
</header>
