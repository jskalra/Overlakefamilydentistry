---
import { Image } from "astro:assets";
import { site, nav } from "../data/site";
import { holidayPromo, promoActive } from "../data/promo";
import MobileNav from "./MobileNav.tsx";
import logo from "../assets/logo/overlake-logo.png";
---
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-navy/5">
  <!-- Transition / heritage banner -->
  {promoActive() ? (
    <a href={holidayPromo.href} data-promo={holidayPromo.endsAt}
      class="block text-cream text-center text-xs md:text-sm py-2 px-4 border-b-2 border-[#a8323a] bg-[linear-gradient(180deg,#2f5a43,#1d3d2c)] hover:bg-[linear-gradient(180deg,#356650,#234a36)] [font-variant-numeric:lining-nums]">
      <span class="inline-block rounded-full bg-[#a8323a] px-2.5 py-0.5 mr-1.5 text-[10px] md:text-xs font-bold uppercase tracking-wider text-white">✦ {holidayPromo.label}</span>
      {holidayPromo.short} <span class="font-semibold text-[#e6cf8f] underline underline-offset-2 whitespace-nowrap">See the offer →</span>
    </a>
  ) : null}
  <div data-promo-fallback class:list={["bg-navy text-cream text-center text-xs md:text-sm py-2 px-4", promoActive() && "hidden"]}>
    {site.name} — {site.transitionBanner}
    <span class="opacity-80 hidden sm:inline">({site.heritage})</span>
  </div>

  <div class="container-page relative flex items-center justify-between gap-6 py-4">
    <a href="/" class="flex items-center shrink-0" aria-label={`${site.name} — home`}>
      <Image src={logo} alt={site.name} class="h-9 sm:h-10 lg:h-11 w-auto" widths={[340, 440, 660]} sizes="(max-width: 768px) 175px, 215px" loading="eager" />
    </a>

    <nav class="hidden lg:flex items-center gap-4 xl:gap-5">
      {nav.map((item) => (
        <a href={item.href} class="whitespace-nowrap text-navy/80 hover:text-navy font-medium text-sm transition-colors">{item.label}</a>
      ))}
      <div class="flex items-center gap-2 pl-1">
        <a href="/contact" class="hidden xl:inline-flex items-center rounded-full border border-slate/60 px-3.5 py-1.5 text-xs font-medium text-navy whitespace-nowrap hover:bg-cream transition-colors">
          <span class="min-[1400px]:hidden">Book Online</span><span class="hidden min-[1400px]:inline">Request an Appointment</span>
        </a>
        <a href={site.phoneHref} class="inline-flex items-center rounded-full bg-navy px-3.5 py-1.5 text-xs font-medium text-cream whitespace-nowrap hover:bg-navy-dark transition-colors">Call {site.phone}</a>
      </div>
    </nav>

    <MobileNav client:load items={nav} phone={site.phone} phoneHref={site.phoneHref} />
  </div>
</header>
