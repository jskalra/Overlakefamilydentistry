---
// Prominent dental-emergency callout. Used on high-intent pages (Contact, New Patients).
import { site } from "../data/site";
---
<div class="rounded-2xl bg-navy text-cream px-6 py-5 flex flex-col sm:flex-row sm:items-center gap-4 shadow-lg ring-1 ring-sage/40">
  <div class="flex items-center gap-3 shrink-0">
    <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true" class="text-sage">
      <path fill="currentColor" d="M12 2 1 21h22L12 2Zm0 4.6L19.5 19h-15L12 6.6ZM11 10v4h2v-4h-2Zm0 6v2h2v-2h-2Z"/>
    </svg>
    <div>
      <div class="font-semibold uppercase tracking-wide text-sm">Dental Emergency?</div>
      <p class="text-cream/75 text-sm">Can't reach the front desk? Call or text this line directly.</p>
    </div>
  </div>
  <a href={site.emergencyPhoneHref}
     class="sm:ml-auto inline-flex items-center justify-center rounded-lg bg-sage text-navy font-semibold px-5 py-3 text-lg hover:bg-cream transition-colors">
    {site.emergencyPhone}
  </a>
</div>
