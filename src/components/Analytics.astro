---
// Consent-gated Google tags (MHMDA / privacy). NOTHING loads until the user
// accepts via the cookie banner, which dispatches a `consent-granted` event.
//
// Preferred: set PUBLIC_GTM_ID ("GTM-XXXXXXX") — loads Google Tag Manager so
// GA4, Google Ads conversion, remarketing, etc. are managed in the GTM UI
// (no code deploy needed). Consent Mode v2 defaults to denied and flips to
// granted on accept, so Google tags behave correctly once they fire.
//
// Fallback (legacy): if only PUBLIC_GA_ID ("G-XXXXXXXXXX") is set, load GA4
// directly with the built-in conversion event tracking below.
//
// Two containers share one dataLayer and one consent gate: GTM-M6XQFBJR (owner)
// and GTM-W5CTWNGS (consultant). Keep each tag in only ONE container, or
// GA4 pageviews and Ads conversions will double-count.
const gtmIds = (import.meta.env.PUBLIC_GTM_ID || "GTM-M6XQFBJR,GTM-W5CTWNGS")
  .split(",").map((id: string) => id.trim()).filter(Boolean);
const gaId = import.meta.env.PUBLIC_GA_ID;
---
{gtmIds.length > 0 && (
  <script is:inline define:vars={{ gtmIds }}>
    (function () {
      const KEY = "ofd-consent";
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = window.gtag || gtag;

      // Consent Mode v2 — everything denied by default (hard gate below also
      // prevents GTM from loading at all until the user accepts).
      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
      });

      // Bridge our built-in conversion signals into the dataLayer so GTM
      // triggers can fire tags (GA4 events, Ads conversions) off them.
      document.addEventListener("click", function (e) {
        const a = e.target.closest("a, button");
        if (!a) return;
        const href = a.getAttribute("href") || "";
        if (href.startsWith("tel:")) window.dataLayer.push({ event: "call_click", value: href });
        else if (/maps|directions/i.test(href)) window.dataLayer.push({ event: "directions_click" });
        else if (/contact|appointment|request/i.test((a.textContent || "").toLowerCase()))
          window.dataLayer.push({ event: "appointment_cta_click" });
      });
      document.addEventListener("submit", function () {
        window.dataLayer.push({ event: "contact_form_submit" });
      });

      function loadGTM() {
        if (window.__gtmLoaded) return;
        window.__gtmLoaded = true;
        gtag("consent", "update", {
          ad_storage: "granted",
          ad_user_data: "granted",
          ad_personalization: "granted",
          analytics_storage: "granted",
        });
        window.dataLayer.push({ "gtm.start": Date.now(), event: "gtm.js" });
        gtmIds.forEach(function (id) {
          const s = document.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtm.js?id=" + id;
          document.head.appendChild(s);
        });

        // Google Ads "calls from website": swaps the displayed office number for a
        // Google forwarding number for ad visitors, so phone calls count as conversions.
        const aw = document.createElement("script");
        aw.async = true;
        aw.src = "https://www.googletagmanager.com/gtag/js?id=AW-18436997887";
        document.head.appendChild(aw);
        gtag("js", new Date());
        gtag("config", "AW-18436997887");
        gtag("config", "AW-18436997887/DzjVCM2K6ZYdEP-FuddE", {
          phone_conversion_number: "(425) 883-3040",
        });
      }
      if (localStorage.getItem(KEY) === "accepted") loadGTM();
      window.addEventListener("consent-granted", loadGTM);
    })();
  </script>
)}
{gtmIds.length === 0 && gaId && (
  <script is:inline define:vars={{ gaId }}>
    (function () {
      const KEY = "ofd-consent";
      function loadGA() {
        if (window.__gaLoaded) return;
        window.__gaLoaded = true;
        const s = document.createElement("script");
        s.async = true;
        s.src = "https://www.googletagmanager.com/gtag/js?id=" + gaId;
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag("js", new Date());
        window.gtag("config", gaId, { anonymize_ip: true });

        // Conversion events: phone clicks, appointment CTAs, directions, form submit.
        document.addEventListener("click", function (e) {
          const a = e.target.closest("a, button");
          if (!a) return;
          const href = a.getAttribute("href") || "";
          if (href.startsWith("tel:")) window.gtag("event", "call_click", { value: href });
          else if (/maps|directions/i.test(href)) window.gtag("event", "directions_click");
          else if (/contact|appointment|request/i.test((a.textContent || "").toLowerCase()))
            window.gtag("event", "appointment_cta_click");
        });
        document.addEventListener("submit", function () {
          window.gtag("event", "contact_form_submit");
        });
      }
      if (localStorage.getItem(KEY) === "accepted") loadGA();
      window.addEventListener("consent-granted", loadGA);
    })();
  </script>
)}
