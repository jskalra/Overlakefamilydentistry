---
// Consent-gated GA4 (MHMDA / privacy). Nothing loads until the user accepts
// via the cookie banner, which dispatches a `consent-granted` event.
// Set PUBLIC_GA_ID in the environment (e.g. "G-XXXXXXXXXX") to enable.
const gaId = import.meta.env.PUBLIC_GA_ID;
---
{gaId && (
  <script is:inline define:vars={{ gaId }}>
    (function () {
      const KEY = "ofd-consent";
      function loadGA() {
        if (window.__gaLoaded) return;
        window.__gaLoaded = true;
        const s = document.createElement("script");
        s.async = true;
        s.src = "https://www.googletagmanager.com/gtag/js?id=" + gaId;
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag("js", new Date());
        window.gtag("config", gaId, { anonymize_ip: true });

        // Conversion events: phone clicks, appointment CTAs, directions, form submit.
        document.addEventListener("click", function (e) {
          const a = e.target.closest("a, button");
          if (!a) return;
          const href = a.getAttribute("href") || "";
          if (href.startsWith("tel:")) window.gtag("event", "call_click", { value: href });
          else if (/maps|directions/i.test(href)) window.gtag("event", "directions_click");
          else if (/contact|appointment|request/i.test((a.textContent || "").toLowerCase()))
            window.gtag("event", "appointment_cta_click");
        });
        document.addEventListener("submit", function () {
          window.gtag("event", "contact_form_submit");
        });
      }
      if (localStorage.getItem(KEY) === "accepted") loadGA();
      window.addEventListener("consent-granted", loadGA);
    })();
  </script>
)}
