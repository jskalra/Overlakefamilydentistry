---
import { Image } from "astro:assets";
import { site } from "../data/site";
import Button from "./Button.astro";
import teamPhoto from "../assets/team.jpg";
interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
}
const {
  eyebrow,
  title = site.tagline,
  subtitle = "Comprehensive, tooth-preserving care from a team that has looked after Eastside families for generations. No pressure. No unnecessary treatment.",
} = Astro.props;

const areas = [
  { label: "Bellevue", href: "/dentist/bellevue" },
  { label: "Bel-Red", href: "/dentist/bellevue" },
  { label: "Redmond", href: "/dentist/redmond" },
  { label: "Kirkland", href: "/dentist/kirkland" },
];
---
<section class="bg-cream-soft">
  <div class="container-page section grid md:grid-cols-2 gap-10 items-center">
    <div>
      {eyebrow ? (
        <p class="eyebrow">{eyebrow}</p>
      ) : (
        <p class="eyebrow flex flex-wrap items-center gap-x-2 gap-y-1">
          {areas.map((a, i) => (
            <>
              {i > 0 && <span class="text-slate/50" aria-hidden="true">|</span>}
              <a href={a.href} class="hover:text-navy transition-colors">{a.label}</a>
            </>
          ))}
        </p>
      )}
      <h1 class="text-xl sm:text-2xl md:text-3xl font-semibold mt-4 leading-tight whitespace-nowrap">{title}</h1>
      <p class="mt-6 text-lg text-slate max-w-lg">{subtitle}</p>
      <div class="mt-8 flex gap-4 flex-wrap">
        <Button href={site.phoneHref} variant="primary">Call {site.phone}</Button>
        <Button href="/contact" variant="secondary">Request an Appointment</Button>
      </div>
      <div class="mt-8 flex gap-6 text-sm text-navy/70">
        <span>Serving Eastside families for 30+ years</span>
        <span>Free building parking</span>
      </div>
    </div>
    <div class="rounded-3xl overflow-hidden aspect-[4/3]">
      <Image src={teamPhoto} alt="The Overlake Family Dentistry team in Bellevue" class="w-full h-full object-cover" widths={[400, 800, 1200]} sizes="(max-width: 768px) 100vw, 50vw" />
    </div>
  </div>
</section>
