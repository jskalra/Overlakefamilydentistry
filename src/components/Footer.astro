---
import { site, nav, serviceCategories, serviceAreas } from "../data/site";
const { address } = site;
---
<footer class="bg-navy text-cream/90 mt-16">
  <div class="container-page py-14 grid gap-10 md:grid-cols-4">
    <div class="md:col-span-1">
      <div class="font-heading text-2xl font-semibold text-cream">Overlake</div>
      <div class="text-cream/70 text-sm uppercase tracking-wide">Family Dentistry</div>
      <p class="mt-4 text-sm text-cream/70">{site.heritage}.</p>
    </div>

    <div>
      <h3 class="text-cream font-semibold mb-3 text-sm uppercase tracking-wide">Explore</h3>
      <ul class="space-y-2 text-sm">
        {nav.map((i) => <li><a href={i.href} class="text-cream/80 hover:text-cream">{i.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h3 class="text-cream font-semibold mb-3 text-sm uppercase tracking-wide">Services</h3>
      <ul class="space-y-2 text-sm">
        {serviceCategories.map((s) => <li><a href={s.href} class="text-cream/80 hover:text-cream">{s.title}</a></li>)}
      </ul>
    </div>

    <div>
      <h3 class="text-cream font-semibold mb-3 text-sm uppercase tracking-wide">Visit Us</h3>
      <address class="not-italic text-sm text-cream/80 space-y-1">
        <div>{address.street}</div>
        <div>{address.city}, {address.state} {address.zip}</div>
        <div class="mt-2"><a href={site.phoneHref} class="hover:text-cream">{site.phone}</a></div>
        <div><a href={`mailto:${site.email}`} class="hover:text-cream">{site.email}</a></div>
      </address>
      <div class="mt-4">
        <h4 class="text-cream font-semibold text-xs uppercase tracking-wide mb-1">Office Hours</h4>
        <ul class="text-sm text-cream/70 space-y-0.5">
          {site.hours.map((h) => (
            <li class="flex justify-between gap-4">
              <span>{h.day}</span>
              <span>{h.close ? `${h.open}–${h.close}` : h.open}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="mt-4 rounded-lg bg-sage/20 border border-sage/50 px-4 py-3">
        <div class="text-sage font-semibold uppercase tracking-wide text-xs">⚠ Dental Emergency?</div>
        <p class="text-cream/70 text-xs mt-1">Can't reach the front desk? Call or text:</p>
        <a href={site.emergencyPhoneHref} class="mt-1 inline-block text-cream font-bold text-lg hover:text-sage">{site.emergencyPhone}</a>
      </div>
      <a href={site.googleProfile} target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-2 text-cream/80 hover:text-cream text-sm">
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 10.2v3.9h5.5c-.24 1.4-1.7 4.1-5.5 4.1a6.2 6.2 0 0 1 0-12.4c1.9 0 3.2.8 3.9 1.5l2.7-2.6C17.1 2.6 14.8 1.6 12 1.6a10.4 10.4 0 0 0 0 20.8c6 0 10-4.2 10-10.1 0-.7-.1-1.2-.2-1.7z"/></svg>
        Review us on Google
      </a>
      <a href={site.yelpProfile} target="_blank" rel="noopener" class="mt-2 flex items-center gap-2 text-cream/80 hover:text-cream text-sm">
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="#FF1A1A" d="M12.3 2.1c-.6-.4-4.1.6-4.8 1.3-.4.4-.4.9-.3 1.3l3.7 6.4c.5.8 1.8.5 1.8-.5V2.9c0-.3-.1-.6-.4-.8zM10.6 14.5l-4.7 1.5c-.5.2-.7.7-.6 1.2.3 1.4 1.4 3.4 2.3 3.9.4.2.9.1 1.2-.2l3.2-3.9c.6-.7-.1-1.9-1-1.6l-.4-.9zm1.8-2.2c-.5.8.1 1.9 1 1.8l5-.6c.5-.1.9-.5.8-1-.1-1.4-1.4-3.6-2.4-4.1-.4-.2-.9-.1-1.2.3l-3.2 3.6zm1.3 3.5l2.7 4.3c.3.4.8.6 1.2.4 1.3-.6 2.9-2.4 3.1-3.4.1-.5-.2-.9-.6-1.1l-4.8-1.6c-.9-.3-1.7.7-1.6 1.4zM9.2 11.4 4.4 9.6c-.5-.2-1 0-1.2.5-.5 1.3-.6 3.7-.1 4.6.2.4.7.6 1.1.5l4.9-1.3c.9-.3.9-1.6.1-2.5z"/></svg>
        Find us on Yelp
      </a>
    </div>
  </div>

  <div class="border-t border-cream/10">
    <div class="container-page py-5 flex flex-col sm:flex-row items-start sm:items-center gap-2 sm:gap-4 text-sm">
      <span class="text-cream font-semibold uppercase tracking-wide text-xs">Areas We Serve</span>
      <div class="flex flex-wrap gap-x-4 gap-y-1">
        {serviceAreas.map((a) => (
          <a href={a.href} class="text-cream/80 hover:text-cream">{a.label}</a>
        ))}
      </div>
    </div>
  </div>

  <div class="border-t border-cream/10">
    <div class="container-page py-5 flex flex-col md:flex-row justify-between gap-3 text-xs text-cream/60">
      <span>© {new Date().getFullYear()} {site.name}. All rights reserved.</span>
      <div class="flex gap-4">
        <a href="/privacy-policy" class="hover:text-cream">Privacy</a>
        <a href="/cookie-policy" class="hover:text-cream">Cookies</a>
        <a href="/accessibility" class="hover:text-cream">Accessibility</a>
      </div>
    </div>
  </div>
</footer>
