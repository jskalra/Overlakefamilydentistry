---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import { site } from "../data/site";
import { homeFaqs, aboutFaqs, servicesFaqs, type Faq } from "../data/faqs";
import { faqSchema } from "../lib/schema";

// Pull FAQs from every page and content entry so answers stay in one place.
type Group = { id: string; title: string; intro?: string; subgroups: { title?: string; href?: string; faqs: Faq[] }[] };

const norm = (q: string) => q.toLowerCase().replace(/[^a-z0-9]+/g, " ").trim();
const seen = new Set<string>();
const unique = (faqs: Faq[]) => faqs.filter((f) => !seen.has(norm(f.q)) && seen.add(norm(f.q)));

// Blog posts keep FAQs in markdown under "## Frequently asked questions" as "### Question" + answer.
function blogFaqs(body = ""): Faq[] {
  const sec = body.split(/^## Frequently asked questions\s*$/m)[1];
  if (!sec) return [];
  return sec.split(/^## /m)[0].split(/^### /m).slice(1).map((chunk) => {
    const [q, ...rest] = chunk.split("\n");
    return { q: q.trim(), a: rest.join("\n").trim() };
  }).filter((f) => f.q && f.a);
}

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const cats = services.filter((s) => s.data.isCategory).sort((a, b) => a.data.heading.localeCompare(b.data.heading));
const locations = await getCollection("locations");
const posts = (await getCollection("blog")).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const groups: Group[] = [
  { id: "new-patients", title: "New patients & visits", subgroups: [{ faqs: unique(homeFaqs) }] },
  { id: "our-practice", title: "About our practice", subgroups: [{ faqs: unique(aboutFaqs) }] },
  { id: "services", title: "Services & treatment", subgroups: [{ faqs: unique(servicesFaqs) }] },
  ...cats.map((c) => ({
    id: c.data.categorySlug,
    title: c.data.heading,
    subgroups: services
      .filter((s) => !s.data.isCategory && s.data.categorySlug === c.data.categorySlug)
      .map((s) => ({ title: s.data.heading, href: `/services/${s.id}`, faqs: unique(s.data.faq) })),
  })),
  {
    id: "locations",
    title: "Our location & areas we serve",
    subgroups: locations.map((l) => ({ title: l.data.suburb, href: `/dentist/${l.id}`, faqs: unique(l.data.faq) })),
  },
  {
    id: "blog",
    title: "From our blog",
    subgroups: posts.map((p) => ({ title: p.data.heading, href: `/blog/${p.id}`, faqs: unique([...p.data.faq, ...blogFaqs(p.body)]) })),
  },
].map((g) => ({ ...g, subgroups: g.subgroups.filter((s) => s.faqs.length) })).filter((g) => g.subgroups.length);

const all = groups.flatMap((g) => g.subgroups.flatMap((s) => s.faqs));

// Minimal markdown for answers: escape HTML, then links and bold.
const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const md = (t: string) =>
  esc(t)
    .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="text-slate underline hover:text-navy">$1</a>')
    .split(/\n{2,}/).map((p) => `<p>${p.replace(/\n/g, " ")}</p>`).join("");
const plain = (t: string) => t.replace(/\*\*(.+?)\*\*/g, "$1").replace(/\[([^\]]+)\]\([^)]+\)/g, "$1");

const schema = faqSchema(all.map((f) => ({ q: f.q, a: plain(f.a) })));
---
<BaseLayout
  title="Frequently Asked Questions | Overlake Family Dentistry, Bellevue"
  description={`Answers to ${all.length} common questions about visits, insurance, treatments, and kids' care at Overlake Family Dentistry in Bellevue, WA.`}
  jsonLd={[schema].filter(Boolean) as object[]}
>
  <section class="bg-cream-soft">
    <div class="container-page section text-center max-w-2xl mx-auto">
      <p class="eyebrow">Answers</p>
      <h1 class="text-4xl md:text-5xl font-semibold mt-3">Frequently Asked Questions</h1>
      <p class="mt-5 text-lg text-slate">
        Every question we answer across the site, in one place. Can't find yours? Call us at{" "}
        <a href={site.phoneHref} class="text-navy font-medium hover:underline">{site.phone}</a>.
      </p>
      <label class="block mt-8 text-left">
        <span class="sr-only">Search questions</span>
        <input id="faq-search" type="search" placeholder="Search questions, e.g. insurance, Invisalign, kids"
          class="w-full rounded-full border border-navy/15 bg-white px-5 py-3 text-navy shadow-sm" />
      </label>
      <p id="faq-empty" class="mt-4 text-sm text-slate hidden">No matching questions. Try another word, or call us.</p>
    </div>
  </section>

  <div class="container-page section grid lg:grid-cols-[220px_1fr] gap-10">
    <nav class="hidden lg:block" aria-label="FAQ topics">
      <ul class="sticky top-36 space-y-2 text-sm">
        {groups.map((g) => <li><a href={`#${g.id}`} class="text-slate hover:text-navy">{g.title}</a></li>)}
      </ul>
    </nav>

    <div class="space-y-14 min-w-0">
      {groups.map((g) => (
        <section id={g.id} class="faq-group scroll-mt-36">
          <h2 class="text-2xl md:text-3xl font-semibold">{g.title}</h2>
          {g.subgroups.map((s) => (
            <div class="faq-sub mt-6">
              {s.title && (
                <h3 class="text-lg font-semibold text-navy flex items-baseline gap-3">
                  {s.title}
                  {s.href && <a href={s.href} class="text-xs font-medium text-slate hover:text-navy">Read more →</a>}
                </h3>
              )}
              <div class="mt-3 space-y-3">
                {s.faqs.map((f) => (
                  <details class="faq-item card">
                    <summary class="font-semibold cursor-pointer">{f.q}</summary>
                    <div class="mt-3 text-slate space-y-3" set:html={md(f.a)} />
                  </details>
                ))}
              </div>
            </div>
          ))}
        </section>
      ))}
    </div>
  </div>

  <section class="bg-cream-soft section text-center">
    <h2 class="text-2xl md:text-3xl font-semibold">Still have a question?</h2>
    <div class="mt-6 flex gap-4 justify-center flex-wrap">
      <Button href={site.phoneHref} variant="primary">Call {site.phone}</Button>
      <Button href="/contact" variant="secondary">Send us a message</Button>
    </div>
  </section>
</BaseLayout>

<script>
  const input = document.getElementById("faq-search") as HTMLInputElement | null;
  const empty = document.getElementById("faq-empty");
  input?.addEventListener("input", () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    document.querySelectorAll<HTMLElement>(".faq-group").forEach((g) => {
      let groupShown = 0;
      g.querySelectorAll<HTMLElement>(".faq-sub").forEach((s) => {
        let subShown = 0;
        s.querySelectorAll<HTMLDetailsElement>(".faq-item").forEach((d) => {
          const hit = !q || (d.textContent || "").toLowerCase().includes(q);
          d.hidden = !hit;
          d.open = !!q && hit;
          if (hit) subShown++;
        });
        s.hidden = subShown === 0;
        groupShown += subShown;
      });
      g.hidden = groupShown === 0;
      shown += groupShown;
    });
    empty?.classList.toggle("hidden", shown > 0);
  });
</script>
