---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blogImages } from "../../data/blogImages";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const hero = blogImages[entry.id];
---
<BaseLayout title={d.title} description={d.metaDescription}>
  <article class="container-page section max-w-2xl mx-auto">
    <a href="/blog" class="text-sm text-slate hover:text-navy">← All articles</a>
    <time class="block mt-6 text-sm text-slate">{d.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time>
    <h1 class="text-4xl font-semibold mt-2">{d.heading}</h1>
    <p class="mt-2 text-slate">By {d.author}</p>
    {hero && (
      <div class="mt-8 rounded-3xl overflow-hidden aspect-[16/9]">
        <Image src={hero.src} alt={hero.alt} class="w-full h-full object-cover" widths={[400, 800, 1200]} sizes="(max-width: 768px) 100vw, 672px" loading="eager" />
      </div>
    )}
    <div class="prose prose-lg mt-8 text-navy/80"><Content /></div>
  </article>
</BaseLayout>
