---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReviewCarousel from "../components/ReviewCarousel.tsx";
import Button from "../components/Button.astro";
import { site } from "../data/site";
import { reviews, isPlaceholder } from "../data/reviews";
---
<BaseLayout
  title="Patient Reviews | Overlake Family Dentistry, Bellevue"
  description="Read what long-time Eastside families say about Overlake Family Dentistry — decades of trust, gentle care, and honest advice."
>
  <section class="bg-cream-soft">
    <div class="container-page section text-center max-w-2xl mx-auto">
      <p class="eyebrow">In Their Own Words</p>
      <h1 class="text-4xl md:text-5xl font-semibold mt-3">Patient Reviews</h1>
    </div>
  </section>

  <section class="container-page section">
    <ReviewCarousel client:visible reviews={reviews} />
    <div class="text-center mt-10 flex flex-col items-center gap-3">
      <a href={site.googleProfile} target="_blank" rel="noopener" class="btn btn-primary">Read all reviews on Google</a>
      <a href={site.googleProfile} target="_blank" rel="noopener" class="text-sm text-slate underline hover:text-navy">Leave us a review</a>
      <a href={site.yelpProfile} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm text-slate underline hover:text-navy"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path fill="#FF1A1A" d="M12.3 2.1c-.6-.4-4.1.6-4.8 1.3-.4.4-.4.9-.3 1.3l3.7 6.4c.5.8 1.8.5 1.8-.5V2.9c0-.3-.1-.6-.4-.8zM10.6 14.5l-4.7 1.5c-.5.2-.7.7-.6 1.2.3 1.4 1.4 3.4 2.3 3.9.4.2.9.1 1.2-.2l3.2-3.9c.6-.7-.1-1.9-1-1.6l-.4-.9zm1.8-2.2c-.5.8.1 1.9 1 1.8l5-.6c.5-.1.9-.5.8-1-.1-1.4-1.4-3.6-2.4-4.1-.4-.2-.9-.1-1.2.3l-3.2 3.6zm1.3 3.5l2.7 4.3c.3.4.8.6 1.2.4 1.3-.6 2.9-2.4 3.1-3.4.1-.5-.2-.9-.6-1.1l-4.8-1.6c-.9-.3-1.7.7-1.6 1.4zM9.2 11.4 4.4 9.6c-.5-.2-1 0-1.2.5-.5 1.3-.6 3.7-.1 4.6.2.4.7.6 1.1.5l4.9-1.3c.9-.3.9-1.6.1-2.5z"/></svg> See our reviews on Yelp</a>
      {isPlaceholder && <p class="text-xs text-slate">Illustrative examples — verified Google reviews will be added before launch.</p>}
    </div>
  </section>

  <section class="bg-cream section text-center">
    <h2 class="text-2xl md:text-3xl font-semibold">Come see for yourself</h2>
    <div class="mt-6 flex gap-4 justify-center flex-wrap">
      <Button href={site.phoneHref} variant="primary">Call {site.phone}</Button>
      <Button href="/contact" variant="secondary">Request an Appointment</Button>
    </div>
  </section>
</BaseLayout>
