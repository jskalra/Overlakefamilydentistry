---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import { site } from "../data/site";
import teamPhoto from "../assets/team.jpg";
import office7 from "../assets/team/office-0007.jpg";
import office9 from "../assets/team/office-0009.jpg";

const officePhotos = [office7, office9];

// Order matches the team photo, left to right.
const team = [
  { name: "Kris", role: "Front Office Manager" },
  { name: "Kristie", role: "Dental Hygienist" },
  { name: "Dr. Kaur", role: "Dentist" },
  { name: "Marta", role: "Dental Assistant" },
  { name: "Ana", role: "Dental Hygienist" },
  { name: "Jeannie", role: "Front Office Assistant" },
];
---
<BaseLayout
  title="Meet Our Team | Overlake Family Dentistry, Bellevue"
  description="Meet the long-tenured, friendly team behind Overlake Family Dentistry — familiar faces caring for Eastside families for years."
>
  <section class="bg-cream-soft">
    <div class="container-page section text-center max-w-2xl mx-auto">
      <p class="eyebrow">Familiar Faces, Deep Experience</p>
      <h1 class="text-4xl md:text-5xl font-semibold mt-3">Meet Our Team</h1>
      <p class="mt-5 text-lg text-slate">
        Low turnover, long tenure, and genuinely kind chairside manner — the team many of
        our patients have known for a decade or more.
      </p>
    </div>
  </section>

  <section class="container-page section">
    <div class="rounded-3xl overflow-hidden max-w-4xl mx-auto">
      <Image src={teamPhoto} alt="The Overlake Family Dentistry team in Bellevue: Kris, Kristie, Dr. Kaur, Marta, Ana, and Jeannie" class="w-full object-cover" widths={[600, 1000, 1600]} sizes="(max-width: 1024px) 100vw, 900px" />
    </div>
    <div class="max-w-4xl mx-auto mt-8">
      <h2 class="text-2xl font-semibold">From left to right</h2>
      <ol class="mt-4 grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {team.map((m, i) => (
          <li class="flex items-baseline gap-3 rounded-xl bg-cream-soft px-4 py-3">
            <span class="text-sage-dark font-semibold text-sm">{i + 1}</span>
            <span><span class="font-semibold text-navy">{m.name}</span><span class="text-slate">, {m.role}</span></span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-cream-soft">
    <div class="container-page section">
      <div class="text-center max-w-2xl mx-auto">
        <p class="eyebrow">Life at the Office</p>
        <h2 class="text-3xl md:text-4xl font-semibold mt-2">A team that enjoys the work</h2>
        <p class="mt-4 text-slate">
          Good care starts with people who like being here. A few moments from around the office.
        </p>
      </div>
      <div class="mt-10 grid sm:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {officePhotos.map((photo, i) => (
          <div class="rounded-3xl overflow-hidden aspect-[4/3]">
            <Image src={photo} alt={`The team at Overlake Family Dentistry (${i + 1})`} class="w-full h-full object-cover" widths={[400, 800]} sizes="(max-width: 768px) 100vw, 50vw" />
          </div>
        ))}
      </div>
      <p class="mt-6 text-center text-slate text-sm">Individual team bios coming soon.</p>
    </div>
  </section>

  <section class="bg-cream section text-center">
    <h2 class="text-2xl md:text-3xl font-semibold">Ready to meet us in person?</h2>
    <div class="mt-6 flex gap-4 justify-center flex-wrap">
      <Button href={site.phoneHref} variant="primary">Call {site.phone}</Button>
      <Button href="/contact" variant="secondary">Request an Appointment</Button>
    </div>
  </section>
</BaseLayout>
