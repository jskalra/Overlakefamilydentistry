---
import "../styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Overlake Family Dentistry — Gentle, Conservative Dentistry in Bellevue</title>
	</head>
	<body>
		<!-- Transition banner (heritage) -->
		<div class="bg-navy text-cream text-center text-sm py-2 px-4">
			Overlake Family Dentistry — Continuing 25+ Years of Conservative, Patient-First Care in Bellevue
			<span class="opacity-80">(Formerly the Practice of Dr. Brian Brooks)</span>
		</div>

		<main class="max-w-3xl mx-auto px-6 py-20 text-center">
			<p class="text-sage font-semibold tracking-wide uppercase text-sm">Bellevue · Bel-Red Corridor</p>
			<h1 class="text-5xl md:text-6xl font-semibold mt-4 leading-tight">
				Gentle, Conservative Dentistry in Bellevue
			</h1>
			<p class="mt-6 text-lg text-slate max-w-xl mx-auto">
				Comprehensive, tooth-preserving care from a team that has looked after Eastside
				families for generations. No pressure. No unnecessary treatment.
			</p>
			<div class="mt-8 flex gap-4 justify-center flex-wrap">
				<a href="tel:+14258833040" class="bg-navy text-cream px-6 py-3 rounded-full font-medium hover:bg-navy-dark transition">
					Call (425) 883-3040
				</a>
				<a href="/contact" class="border border-slate text-navy px-6 py-3 rounded-full font-medium hover:bg-cream transition">
					Request an Appointment
				</a>
			</div>
			<p class="mt-16 text-xs text-slate">Phase 1 scaffold — build in progress.</p>
		</main>
	</body>
</html>
