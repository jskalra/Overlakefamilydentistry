---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ReviewCarousel from "../components/ReviewCarousel.tsx";
import Button from "../components/Button.astro";
import { serviceCategories } from "../data/site";
import officeLobby from "../assets/office-lobby.jpg";
import officeRoom from "../assets/office-room.jpg";
import drsBrooksKaur from "../assets/drs-brooks-kaur.jpg";
import { site } from "../data/site";
import { reviews, isPlaceholder } from "../data/reviews";
---

<BaseLayout title="Overlake Family Dentistry — Conservative, Tooth-Preserving Care in Bellevue">
  <Hero />

  <!-- Trust strip -->
  <div class="bg-navy text-cream/90">
    <div class="container-page py-4 flex flex-wrap justify-center items-center gap-x-3 gap-y-2 text-sm text-center">
      {["30+ Years on the Eastside", "Columbia & UW Trained", "Conservative, Tooth-Preserving Care", "Free Dedicated Parking"].map((item, i) => (
        <>
          {i > 0 && <span class="text-sage" aria-hidden="true">•</span>}
          <span>{item}</span>
        </>
      ))}
    </div>
  </div>

  <!-- Services snapshot -->
  <section class="container-page section">
    <div class="text-center max-w-2xl mx-auto">
      <p class="eyebrow">Comprehensive In-House Care</p>
      <h2 class="text-3xl md:text-4xl font-semibold mt-2">Everything your family needs, under one roof</h2>
    </div>
    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {serviceCategories.map((s) => (
        <a href={s.href} class="card block">
          <div class="w-10 h-10 rounded-full bg-sage/20 mb-4"></div>
          <h3 class="text-xl font-semibold">{s.title}</h3>
          <p class="mt-2 text-slate text-sm">Learn more about our approach to {s.title.toLowerCase()}.</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Conservative care band with photo -->
  <section class="bg-cream-soft">
    <div class="container-page section grid md:grid-cols-2 gap-10 items-center">
      <div class="rounded-3xl overflow-hidden aspect-[4/3] order-2 md:order-1">
        <Image src={officeRoom} alt="A treatment room at Overlake Family Dentistry" class="w-full h-full object-cover" widths={[400, 800, 1200]} sizes="(max-width: 768px) 100vw, 50vw" />
      </div>
      <div class="order-1 md:order-2">
        <p class="eyebrow">Conservative, Tooth-Preserving Care</p>
        <h2 class="text-3xl md:text-4xl font-semibold mt-2">We treat only what needs treating</h2>
        <p class="mt-5 text-slate text-lg">
          We reach for the least invasive option first — preserving your natural teeth
          whenever possible, and giving you honest second opinions without pressure.
        </p>
        <div class="mt-6"><Button href="/about" variant="secondary">Our Philosophy</Button></div>
      </div>
    </div>
  </section>

  <!-- Meet your doctors -->
  <section class="bg-cream section">
    <div class="container-page">
      <div class="text-center max-w-2xl mx-auto">
        <p class="eyebrow">Experienced, Long-Tenured Team</p>
        <h2 class="text-3xl md:text-4xl font-semibold mt-2">Meet your doctors</h2>
      </div>
      <a href="/doctors" class="group block mt-10 max-w-[470px] mx-auto">
        <div class="rounded-3xl overflow-hidden">
          <Image src={drsBrooksKaur} alt="Dr. Brooks and Dr. Kaur, Overlake Family Dentistry" class="w-full h-auto object-cover transition-transform group-hover:scale-[1.02]" widths={[400, 800, 1200]} sizes="(max-width: 768px) 100vw, 640px" />
        </div>
      </a>
      <div class="text-center mt-8"><Button href="/doctors" variant="secondary">Read Bios</Button></div>
    </div>
  </section>

  <!-- Welcome / office -->
  <section class="container-page section grid md:grid-cols-2 gap-10 items-center">
    <div>
      <p class="eyebrow">Welcome to Our Office</p>
      <h2 class="text-3xl md:text-4xl font-semibold mt-2">A calm, welcoming space in the Bel-Red corridor</h2>
      <p class="mt-5 text-slate text-lg">
        Bright, comfortable, and easy to reach — with free dedicated building parking right
        outside. Come see why Eastside families have felt at home here for years.
      </p>
      <div class="mt-6"><Button href={site.phoneHref} variant="primary">Call {site.phone}</Button></div>
    </div>
    <div class="rounded-3xl overflow-hidden aspect-[4/3]">
      <Image src={officeLobby} alt="The bright, welcoming entrance at Overlake Family Dentistry" class="w-full h-full object-cover" widths={[400, 800, 1200]} sizes="(max-width: 768px) 100vw, 50vw" />
    </div>
  </section>

  <!-- Reviews -->
  <section class="bg-cream section">
    <div class="container-page">
      <div class="text-center mb-10">
        <p class="eyebrow">Multi-Decade Patient Loyalty</p>
        <h2 class="text-3xl md:text-4xl font-semibold mt-2">Families who've trusted us for generations</h2>
      </div>
      <ReviewCarousel client:visible reviews={reviews} />
      <div class="text-center mt-8">
        <a href={site.googleProfile} target="_blank" rel="noopener" class="btn btn-secondary text-sm">Additional Google Reviews</a>
        {isPlaceholder && <p class="mt-4 text-xs text-slate">Illustrative examples — real, verified Google reviews will be added before launch.</p>}
      </div>
    </div>
  </section>
</BaseLayout>
