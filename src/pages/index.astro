---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
---

<BaseLayout title="Overlake Family Dentistry — Gentle, Conservative Dentistry in Bellevue">
  <div class="bg-navy text-cream text-center text-sm py-2 px-4">
    Overlake Family Dentistry — Continuing 25+ Years of Conservative, Patient-First Care in Bellevue
    <span class="opacity-80">(Formerly the Practice of Dr. Brian Brooks)</span>
  </div>

  <main class="container-page section text-center">
    <p class="eyebrow">Bellevue · Bel-Red Corridor</p>
    <h1 class="text-5xl md:text-6xl font-semibold mt-4 leading-tight max-w-3xl mx-auto">
      Gentle, Conservative Dentistry in Bellevue
    </h1>
    <p class="mt-6 text-lg text-slate max-w-xl mx-auto">
      Comprehensive, tooth-preserving care from a team that has looked after Eastside
      families for generations. No pressure. No unnecessary treatment.
    </p>
    <div class="mt-8 flex gap-4 justify-center flex-wrap">
      <Button href="tel:+14258833040" variant="primary">Call (425) 883-3040</Button>
      <Button href="/contact" variant="secondary">Request an Appointment</Button>
    </div>
    <p class="mt-16 text-xs text-slate">Phase 2 — design system. See <a href="/styleguide" class="underline">/styleguide</a>.</p>
  </main>
</BaseLayout>
