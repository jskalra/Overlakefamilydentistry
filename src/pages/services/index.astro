---
import { servicesFaqs as faqs } from "../../data/faqs";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import { site } from "../../data/site";
import { faqSchema } from "../../lib/schema";

const entries = await getCollection("services");
const cats = entries
  .filter((e) => e.data.isCategory)
  .sort((a, b) => a.data.category.localeCompare(b.data.category));
const childrenOf = (slug: string) =>
  entries
    .filter((e) => !e.data.isCategory && e.data.categorySlug === slug)
    .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

// Category descriptions written for this index page (keyed by category id).
// Lengths and openings vary on purpose so the cards don't read as a template.
const catCopy: Record<string, string> = {
  "general-dentistry":
    "Most visits fall here. A checkup and cleaning every six months lets us find a small cavity or a cracked filling while it is still an easy fix. Grinding at night? Custom nightguards protect the enamel. Jaw pain and clicking (often called TMJ problems) get the simplest steps first: a guard, habit changes, and stretches.",
  "cosmetic-dentistry":
    "Whitening and bonding, a tooth-colored resin shaped right on the tooth, remove little or no enamel, so that's usually where we begin. Veneers and crowns mean reshaping the tooth. Those make sense only when a smaller fix won't hold up. Inlays and onlays fall in between.",
  "orthodontic-services":
    "Invisalign straightens teeth with clear, removable trays, for adults and teens. Dr. Kaur has postgraduate training in orthodontics and will tell you plainly if a specialist would serve you better.",
  "pediatric-dentistry":
    "From first teeth through the teen years. Early visits are short and relaxed, mostly counting teeth and getting used to the chair. Later come cleanings, sealants (a thin coating over the grooves of back molars), tooth-colored fillings if a cavity shows up, and sports mouthguards for active kids.",
  "periodontal-services":
    "Bleeding when you brush is often the first sign of gum disease, and it usually doesn't hurt. Caught early, it can often be reversed. Deeper cases need scaling and root planing, a cleaning below the gumline that smooths the roots so the gums can heal.",
  "restorative-dentistry":
    "Broken, infected, or missing teeth. Our first question is always whether the tooth can be saved, and a root canal, which clears infection from inside the tooth, often does that. Teeth that have to come out can be replaced with implants, bridges, partials, or full dentures. Each option differs in cost, time, and what it asks of the teeth next to it, and you'll hear about all of that before you choose.",
};

---
<BaseLayout
  title="Dental Services in Bellevue, WA | Overlake Family Dentistry"
  description="Conservative dental care in Bellevue for the whole family: general, cosmetic, restorative, orthodontic, pediatric, and periodontal services in one office."
  jsonLd={[faqSchema(faqs)].filter(Boolean) as object[]}
>
  <section class="bg-cream-soft">
    <div class="container-page section text-center max-w-2xl mx-auto">
      <p class="eyebrow">Comprehensive In-House Care</p>
      <h1 class="text-4xl md:text-5xl font-semibold mt-3">Our Services</h1>
      <p class="mt-5 text-lg text-slate">
        Care for the whole family in one office in Bellevue's Bel-Red corridor, with the smallest
        treatment that will do the job.
      </p>
      <p class="mt-4 text-slate">
        Eastside families have been coming here for cleanings, fillings, crowns, and everything in
        between for more than 30 years. Dr. Ravneet Kaur now leads the practice and keeps the same
        approach: save your natural teeth when we can, and do the smallest treatment that will work.
        Patients here range from toddlers to seniors. Pick a category below, or tell us what's bothering
        you and we'll point you in the right direction.
      </p>
    </div>
  </section>

  <section class="container-page section">
    <div class="max-w-3xl">
      <p class="eyebrow">Not sure where to start?</p>
      <h2 class="text-3xl md:text-4xl font-semibold mt-3">Which page do you need?</h2>
      <div class="mt-5 space-y-4 text-slate">
        <p>
          If it has been a while since your last visit, or you're simply due, begin with
          <a href="/services/general-dentistry/exams-cleanings" class="font-semibold underline underline-offset-2 hover:text-navy">exams and cleanings</a>.
          Your first visit includes a full exam. Thinking about whiter teeth or fixing a chip? Read about
          <a href="/services/cosmetic-dentistry/teeth-whitening" class="font-semibold underline underline-offset-2 hover:text-navy">whitening</a>
          and <a href="/services/cosmetic-dentistry/bonding" class="font-semibold underline underline-offset-2 hover:text-navy">bonding</a>
          before anything bigger. Children's care is under
          <a href="/services/pediatric-dentistry" class="font-semibold underline underline-offset-2 hover:text-navy">pediatric dentistry</a>;
          the first visit should happen around the first birthday. Crowding or gaps that bother you are covered under
          <a href="/services/orthodontic-services/invisalign" class="font-semibold underline underline-offset-2 hover:text-navy">Invisalign</a>.
        </p>
        <p>
          Nobody expects you to know the dental word for what's wrong. "It hurts when I drink something
          cold" or "my gums bleed when I floss" tells us plenty, and the front desk can book the right
          kind of appointment from that. Families often ask to come in together, so mention it when you book
          and we'll see what times line up. Still unsure which of these fits? Ask when you call.
        </p>
        <p>
          Pain is different. Don't spend time reading. For a toothache, a cracked tooth, or swelling,
          call <a href={site.phoneHref} class="font-semibold underline underline-offset-2 hover:text-navy">{site.phone}</a>
          and describe what's happening, and we'll fit you in as soon as we can. Outside office hours, or any time the
          front desk doesn't pick up, the emergency line is
          <a href={site.emergencyPhoneHref} class="font-semibold underline underline-offset-2 hover:text-navy">{site.emergencyPhone}</a>
          (call or text). Missing teeth can wait for a regular appointment; the options are on the
          <a href="/services/restorative-dentistry" class="font-semibold underline underline-offset-2 hover:text-navy">restorative dentistry</a> page.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-cream">
    <div class="container-page section">
      <div class="max-w-2xl">
        <p class="eyebrow">All services</p>
        <h2 class="text-3xl md:text-4xl font-semibold mt-3">What we do</h2>
        <p class="mt-4 text-slate">
          Six areas of care. Click any treatment under a heading to read how it works and what a visit involves.
        </p>
      </div>
      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {cats.map((c) => (
          <div class="card flex flex-col">
            <div class="w-10 h-10 rounded-full bg-sage/20 mb-4"></div>
            <h3 class="text-xl font-semibold">
              <a href={`/services/${c.id}`} class="hover:text-slate">{c.data.heading}</a>
            </h3>
            <p class="mt-3 text-slate text-sm">{catCopy[c.id] ?? c.data.summary}</p>
            <ul class="mt-4 space-y-1 text-sm list-disc pl-5">
              {childrenOf(c.data.categorySlug).map((d) => (
                <li>
                  <a href={`/services/${d.id}`} class="text-slate hover:text-navy underline-offset-2 hover:underline">
                    {d.data.heading}
                  </a>
                </li>
              ))}
            </ul>
            <a href={`/services/${c.id}`} class="mt-auto pt-5 text-sm font-semibold text-navy hover:text-slate underline underline-offset-2">
              See all {c.data.heading.toLowerCase()} &rarr;
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container-page section">
    <div class="grid lg:grid-cols-2 gap-12">
      <div>
        <p class="eyebrow">Our approach</p>
        <h2 class="text-3xl md:text-4xl font-semibold mt-3">How we recommend treatment</h2>
        <div class="mt-5 space-y-4 text-slate">
          <p>
            You should see what we see. Once your exam is done, your X-rays and photos of your teeth go up
            on a screen and the dentist goes through them with you. Any cavity shows up there, so you'll
            see where it is and how big.
          </p>
          <p>
            That conversation is usually what sorts out which of the pages above applies to you.
            Plenty of people book a cleaning and leave with nothing else to do. Others come in about
            one sore tooth and find out it needs a filling, or that the soreness is coming from
            clenching at night and a guard will help more than any work on the tooth itself.
            Occasionally the X-rays turn up something you couldn't have felt yet, like decay between
            two teeth. None of that is decided before you sit down.
          </p>
          <p>
            New patients start with a full exam, partly so there's a baseline on file. Later
            visits get compared against it. Comparing them is how slow changes, like the edge of an
            old filling breaking down or gums starting to pull back, get noticed while they're still
            small.
          </p>
          <p>
            Options come next, smallest first. Small cavities get small fillings. Worn spots that
            aren't causing trouble may just need watching, and we'll look at it again at your next
            visit instead of drilling now. Enamel doesn't grow back once it's removed, so waiting is
            the better choice whenever it's safe.
          </p>
          <p>
            Bigger treatment, like a crown or a root canal, comes up only when a smaller fix won't last.
            You'll hear why, and what is likely to happen if you hold off. Feel free to ask questions at any
            point, including halfway through a treatment plan.
          </p>
          <p>
            Want a second opinion? Get one. Your X-rays are yours to take. It's your decision, and
            we'll respect it.
          </p>
        </div>
      </div>
      <div class="space-y-6">
        <div class="card">
          <p class="eyebrow">Here or with a specialist</p>
          <p class="mt-3 text-slate">
            Nearly all of your care happens in our office, from cleanings to crowns to Invisalign, so you
            aren't driving across town. Certain cases do better with a specialist who does that one thing
            every day: wisdom teeth sitting deep in the jaw, advanced gum disease, or root canals on
            molars with curved or hard-to-reach canals. In that case we send your records,
            explain the reason, and stay involved afterward. Checkups and the rest of your
            treatment still happen here.
          </p>
        </div>
        <div class="card">
          <p class="eyebrow">Insurance</p>
          <p class="mt-3 text-slate">
            We accept most dental insurance plans and file claims on your behalf. Phone us with your plan
            details and the front desk will confirm what it includes. Coverage varies a lot between
            plans, even ones from the same company, so checking first saves surprises. Ahead of larger work, a
            pre-estimate can go to your insurer so you know your share in advance. Ask before
            treatment starts and you'll get a written estimate.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cream-soft">
    <div class="container-page section max-w-3xl">
      <p class="eyebrow">Questions</p>
      <h2 class="text-3xl md:text-4xl font-semibold mt-3">What patients ask us about treatment</h2>
      <div class="mt-8 space-y-4">
        {faqs.map((f) => (
          <details class="card">
            <summary class="font-semibold cursor-pointer">{f.q}</summary>
            <p class="mt-3 text-slate">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-navy text-cream">
    <div class="container-page section text-center max-w-2xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-semibold text-cream">Ready to book?</h2>
      <p class="mt-4 text-cream/80">
        Send a request online or phone the office. Questions are welcome before you commit to a time.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
        <Button href={site.phoneHref} variant="accent">Call {site.phone}</Button>
        <Button href="/contact" variant="secondary" class="bg-cream">Request an Appointment</Button>
      </div>
    </div>
  </section>
</BaseLayout>
