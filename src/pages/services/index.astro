---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
const entries = await getCollection("services");
const cats = entries.filter((e) => e.data.isCategory).sort((a, b) => a.data.category.localeCompare(b.data.category));
---
<BaseLayout
  title="Dental Services in Bellevue, WA | Overlake Family Dentistry"
  description="Comprehensive, conservative dental services in Bellevue — general, cosmetic, restorative, orthodontic, pediatric, and periodontal care under one roof."
>
  <section class="bg-cream-soft">
    <div class="container-page section text-center max-w-2xl mx-auto">
      <p class="eyebrow">Comprehensive In-House Care</p>
      <h1 class="text-4xl md:text-5xl font-semibold mt-3">Our Services</h1>
      <p class="mt-5 text-lg text-slate">
        Everything your family needs, under one roof in Bellevue's Bel-Red corridor — always
        delivered conservatively and honestly.
      </p>
    </div>
  </section>
  <section class="container-page section">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {cats.map((c) => (
        <a href={`/services/${c.id}`} class="card block">
          <div class="w-10 h-10 rounded-full bg-sage/20 mb-4"></div>
          <h2 class="text-xl font-semibold">{c.data.heading}</h2>
          <p class="mt-2 text-slate text-sm">{c.data.summary}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
