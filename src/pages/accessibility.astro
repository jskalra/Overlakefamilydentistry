---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---
<BaseLayout title="Accessibility Statement | Overlake Family Dentistry" description="Our commitment to an accessible website that meets WCAG 2.1 AA.">
  <section class="container-page section max-w-3xl mx-auto prose prose-lg text-navy/80">
    <p class="eyebrow">Accessibility</p>
    <h1 class="text-4xl font-semibold mt-3">Accessibility Statement</h1>
    <p>
      Overlake Family Dentistry is committed to providing a website that is accessible to
      the widest possible audience. We aim to conform to the Web Content Accessibility
      Guidelines (WCAG) 2.1 Level AA.
    </p>
    <h2>Reporting a problem</h2>
    <p>
      If you experience any difficulty using this site, please call us at
      <a href={site.phoneHref}>{site.phone}</a> and we'll be happy to help.
    </p>
  </section>
</BaseLayout>
