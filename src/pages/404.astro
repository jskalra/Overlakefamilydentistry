---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
---
<BaseLayout title="Page not found | Overlake Family Dentistry" description="The page you're looking for doesn't exist.">
  <section class="container-page section text-center max-w-xl mx-auto">
    <p class="eyebrow">404</p>
    <h1 class="text-4xl md:text-5xl font-semibold mt-3">Page not found</h1>
    <p class="mt-5 text-slate">The page you were looking for isn't here. Let's get you back on track.</p>
    <div class="mt-8"><Button href="/" variant="primary">Back to home</Button></div>
  </section>
</BaseLayout>
