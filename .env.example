# Copy to .env (local) and set in Vercel → Project → Settings → Environment Variables.

# Web3Forms access key — enables background contact-form submission (no email app opens).
# Get a free key at https://web3forms.com using info@drbrianbrooks.com as the destination.
PUBLIC_WEB3FORMS_KEY=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Consent-gated. Leave blank to disable.
PUBLIC_GA_ID=
