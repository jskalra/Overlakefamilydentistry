# Copy to .env (local) and set in Vercel → Project → Settings → Environment Variables.

# Web3Forms access key — enables background contact-form submission (no email app opens).
# Get a free key at https://web3forms.com using info@drbrianbrooks.com as the destination.
PUBLIC_WEB3FORMS_KEY=

# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Preferred — manage GA4 +
# Google Ads conversion tags from the GTM UI. Consent-gated (hard gate: nothing
# loads until the user accepts). Leave blank to disable.
PUBLIC_GTM_ID=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Legacy fallback, only
# used if PUBLIC_GTM_ID is blank. Consent-gated. Leave blank to disable.
PUBLIC_GA_ID=
